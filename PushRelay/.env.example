# Copy into your shell/environment; server.js does not load .env by itself.
PAPERCLIP_URL=https://paperclip.example.com
PAPERCLIP_COMPANY_ID=your-company-uuid
PAPERCLIP_BOARD_TOKEN=pcp_board_your_board_token
PUSH_RELAY_SECRET=generate-a-long-random-secret
APNS_TEAM_ID=YOURAPPLETEAM
APNS_KEY_ID=YOURAPNSKEY
APNS_BUNDLE_ID=dev.example.PaperclipPocket
APNS_PRIVATE_KEY_PATH=/secure/path/AuthKey_XXXXXXXXXX.p8
APNS_ENVIRONMENT=sandbox
PUSH_PORT=8088
PUSH_BIND=127.0.0.1
PUSH_DATA_FILE=./data/state.json
PUSH_POLL_INTERVAL_MS=15000
